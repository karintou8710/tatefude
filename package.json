{
  "name": "tatefude-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --parallel --filter tatefude-demo-frontend --filter tatefude-demo-server dev",
    "dev:frontend": "pnpm --filter tatefude-demo-frontend dev",
    "dev:server": "pnpm --filter tatefude-demo-server dev",
    "build": "pnpm --filter tatefude --filter tatefude-react build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm --filter tatefude test",
    "test:browser": "pnpm --filter tatefude test:browser",
    "test:all": "pnpm --filter tatefude test:all"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13"
  }
}
