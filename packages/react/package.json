    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "tatefude": "workspace:*",
    "react": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
